---
import { Button, Container, TextCardSection } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import { withBase } from '../utils/url.js';

const seo = {
	title: 'Página não encontrada | Classe A Pisos',
	description: 'A página que você procura não existe.',
};
---

<Layout {seo}>
	<Container>
		<TextCardSection>
			<h1>404</h1>
			<h2>Página não encontrada 👀</h2>
			<p>O link pode ter mudado ou a página não existe mais.</p>
			<div class="cta-buttons__container">
				<Button href={withBase('/')}>Voltar para a Home</Button>
			</div>
		</TextCardSection>
	</Container>
</Layout>

<style>
	.cta-buttons__container {
		display: flex;
		flex-wrap: wrap;
	}
	.cta-buttons__container :global(a) {
		margin-right: 1rem;
		margin-bottom: 1rem;
	}
</style>
