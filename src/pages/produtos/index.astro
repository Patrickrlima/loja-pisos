---
import { Container, Button } from '@components/odyssey-theme';
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Page.astro';
import HeroSection from '../../components/sections/heros/HeroSection.astro';
import settings from '../../config/settings.js';
import { withBase } from '../../utils/url.js';

const seo = {
	title: `Produtos | ${settings.name}`,
	description: 'Catálogo de porcelanatos, laminados, vinílicos e pisos para área externa.',
};

const whatsappHref = (produto) =>
	`https://wa.me/${settings.whatsappNumber}?text=${encodeURIComponent(
		`Olá! Vim pelo site e quero um orçamento de ${produto}.`
	)}`;

const categorias = [
	{
		id: 'porcelanato',
		title: 'Porcelanatos',
		img: withBase('/assets/images/produto-porcelanato.jpg'),
		desc: 'Ideal para quem busca durabilidade e sofisticação. Trabalhamos com acabamento acetinado, polido e rústico, em diversos tamanhos de placa, para salas, cozinhas, banheiros e fachadas.',
		itens: ['Acetinado 60x60', 'Polido 80x80', 'Rústico 45x90', 'Retificado grande formato'],
	},
	{
		id: 'laminado',
		title: 'Laminados',
		img: withBase('/assets/images/produto-laminado.jpg'),
		desc: 'O visual aconchegante da madeira com instalação rápida (encaixe clicado) e ótimo custo-benefício. Perfeito para quartos, salas e escritórios.',
		itens: ['Linha Clássica', 'Linha Premium', 'Efeito madeira de demolição', 'Resistente à umidade'],
	},
	{
		id: 'vinilico',
		title: 'Vinílicos',
		img: withBase('/assets/images/produto-vinilico.jpg'),
		desc: 'Resistente à água, macio ao caminhar e fácil de limpar. Ótima opção para cozinhas, áreas comerciais e ambientes de alto tráfego.',
		itens: ['Régua vinílica', 'Manta vinílica', 'Persiana / Wall Deck', 'Autocolante e clicado'],
	},
	{
		id: 'externo',
		title: 'Área Externa',
		img: withBase('/assets/images/produto-externo.jpg'),
		desc: 'Pisos antiderrapantes (PEI/PTV adequados) para varandas, piscinas, decks e calçadas, resistentes à chuva e ao sol.',
		itens: ['Deck cerâmico', 'Porcelanato antiderrapante', 'Piso atérmico para piscina', 'Pastilhas e cimentícios'],
	},
];
---

<Layout {seo}>
	<HeroSection>
		<Fragment slot="text-container">
			<h1>Nossos Produtos</h1>
			<p>
				Confira nossas principais linhas de pisos. Todos os itens abaixo são
				exemplos — a loja pode substituir por fotos e modelos reais do estoque.
			</p>
		</Fragment>
		<div slot="image-container" class="produtos-hero__video-wrap">
			<video
				class="produtos-hero__video"
				src={withBase('/assets/images/produtos-video.mp4')}
				poster={withBase('/assets/images/produtos-video-poster.jpg')}
				autoplay
				muted
				loop
				playsinline
				preload="auto"
			></video>
		</div>
	</HeroSection>

	{categorias.map((cat, i) => (
		<Container>
			<section id={cat.id} class={`produto__section ${i % 2 === 1 ? 'produto__section--reversed' : ''} reveal-on-scroll`}>
				<div class="produto__image zoom-container">
					<img src={cat.img} alt={cat.title} loading="lazy" />
				</div>
				<div class="produto__text">
					<h2 class="reveal-letters">
						{cat.title.split('').map((letra, li) => (
							<span style={`--letter-index: ${li}`}>{letra === ' ' ? '\u00A0' : letra}</span>
						))}
					</h2>
					<p>{cat.desc}</p>
					<ul class="produto__lista">
						{cat.itens.map((item) => (
							<li>
								<Icon name="mdi:check-circle-outline" width={20} height={20} />
								{item}
							</li>
						))}
					</ul>
					<Button href={whatsappHref(cat.title)} newTab customIcon data-action="open-whatsapp">
						Orçar {cat.title}
						<Fragment slot="icon">
							<Icon name="mdi:whatsapp" />
						</Fragment>
					</Button>
				</div>
			</section>
		</Container>
	))}
</Layout>

<style>
	/* Nomes de categoria: Playfair Display (mesma fonte dos títulos do
	   site), um pouco maior que o texto padrão do h2. */
	.produto__text h2 {
		font-size: var(--font-size-xl);
	}
	.produtos-hero__video-wrap {
		width: 100%;
		height: 100%;
	}
	.produtos-hero__video {
		width: 100%;
		height: 100%;
		max-height: 80vh;
		object-fit: cover;
		border-radius: var(--theme-shape-radius);
		display: block;
	}
	.produto__section {
		margin: calc(var(--section-margin) * 1.5) auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		gap: 2rem;
	}
	.produto__section--reversed .produto__image {
		order: 2;
	}
	.produto__image img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--theme-shape-radius);
	}
	.zoom-container {
		position: relative;
		overflow: hidden;
	}
	@media (pointer: fine) {
		.zoom-container {
			cursor: zoom-in;
		}
		.zoom-container img {
			transition: transform 0.25s ease-out;
			will-change: transform;
		}
		.zoom-container.zoom-active img {
			transform: scale(2.4);
		}
	}
	.produto__lista {
		margin: 1.25rem 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.produto__lista li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.produto__lista li :global(svg) {
		color: var(--theme-primary);
		flex-shrink: 0;
	}
	/* Mesmo efeito de revelação da Home: a seção aparece suave quando
	   entra na tela, e o título surge letra por letra. A foto desliza de
	   fora da tela até o lugar dela (da direita nas seções normais, da
	   esquerda nas invertidas, acompanhando o layout). */
	.reveal-on-scroll {
		opacity: 0;
		transition: opacity 0.5s ease;
	}
	.reveal-on-scroll.is-visible {
		opacity: 1;
	}
	.produto__image img {
		transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
		transform: translateX(50%) scale(1.15);
	}
	.produto__section--reversed .produto__image img {
		transform: translateX(-50%) scale(1.15);
	}
	.reveal-on-scroll.is-visible .produto__image img {
		transform: translateX(0) scale(1);
	}
	.reveal-letters span {
		display: inline-block;
		opacity: 0;
		transform: translateX(-12px);
		transition: opacity 0.35s ease, transform 0.35s ease;
		transition-delay: calc(var(--letter-index) * 35ms);
	}
	.reveal-on-scroll.is-visible .reveal-letters span {
		opacity: 1;
		transform: translateX(0);
	}
	@media (prefers-reduced-motion: reduce) {
		.reveal-on-scroll,
		.reveal-letters span {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}

	@media (max-width: 768px) {
		.produto__section,
		.produto__section--reversed .produto__image {
			grid-template-columns: 1fr;
			order: 0;
		}
		.produto__section {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	// Efeito de zoom na imagem inteira ao passar o mouse: a foto amplia
	// e acompanha a posição do cursor, como se você tivesse "entrando"
	// nela. Só ativa em dispositivos com mouse de precisão (desktop) —
	// no celular/touch a imagem continua normal, sem zoom.

	function setupZoom(container: HTMLElement) {
		const img = container.querySelector<HTMLElement>('img');
		if (!img) return;

		function moveZoom(e: MouseEvent) {
			const rect = container.getBoundingClientRect();
			if (rect.width === 0 || rect.height === 0) return;

			const percentX = ((e.clientX - rect.left) / rect.width) * 100;
			const percentY = ((e.clientY - rect.top) / rect.height) * 100;

			img!.style.transformOrigin = `${percentX}% ${percentY}%`;
		}

		container.addEventListener('mouseenter', (e) => {
			moveZoom(e as MouseEvent);
			container.classList.add('zoom-active');
		});
		container.addEventListener('mousemove', moveZoom);
		container.addEventListener('mouseleave', () => {
			container.classList.remove('zoom-active');
			img.style.transformOrigin = 'center center';
		});
	}

	function initZoom() {
		if (!window.matchMedia('(pointer: fine)').matches) return;
		document.querySelectorAll<HTMLElement>('.zoom-container').forEach(setupZoom);
	}

	// Ativa a animação de entrada (seção + letras do título) só quando o
	// elemento aparece na tela ao rolar, uma única vez.
	function setupReveal() {
		const els = document.querySelectorAll<HTMLElement>('.reveal-on-scroll');
		if (!('IntersectionObserver' in window) || els.length === 0) {
			els.forEach((el) => el.classList.add('is-visible'));
			return;
		}
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
		);
		els.forEach((el) => observer.observe(el));
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', () => {
			initZoom();
			setupReveal();
		});
	} else {
		initZoom();
		setupReveal();
	}
</script>
