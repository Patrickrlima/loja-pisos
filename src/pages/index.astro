---
import {
	Container,
	Button,
	StickyTextImageSection,
	CtaCardSection,
} from '@components/odyssey-theme';
import { Icon } from 'astro-icon/components';

import Layout from '../layouts/Page.astro';
import HomeHeroSection from '../components/sections/heros/HomeHeroSection.astro';
import settings from '../config/settings.js';
import { withBase } from '../utils/url.js';

const whatsappHref = `https://wa.me/${settings.whatsappNumber}?text=${encodeURIComponent(settings.whatsappMessage)}`;

const categorias = [
	{
		title: 'Porcelanatos',
		desc: 'Acabamento acetinado, polido ou rústico para sala, cozinha e fachadas.',
		img: withBase('/assets/images/produto-porcelanato.jpg'),
		href: withBase('/produtos#porcelanato'),
	},
	{
		title: 'Laminados',
		desc: 'Aconchego e praticidade com o visual da madeira, por um preço acessível.',
		img: withBase('/assets/images/produto-laminado.jpg'),
		href: withBase('/produtos#laminado'),
	},
	{
		title: 'Vinílicos',
		desc: 'Resistente à água, fácil de instalar e ótimo custo-benefício.',
		img: withBase('/assets/images/produto-vinilico.jpg'),
		href: withBase('/produtos#vinilico'),
	},
	{
		title: 'Área Externa',
		desc: 'Pisos antiderrapantes para varandas, piscinas e decks.',
		img: withBase('/assets/images/produto-externo.jpg'),
		href: withBase('/produtos#externo'),
	},
];

const galeriaFotos = [
	{ src: withBase('/assets/images/galeria/galeria-1.jpg'), alt: 'Box de banheiro com porcelanato efeito mármore azul' },
	{ src: withBase('/assets/images/galeria/galeria-2.jpg'), alt: 'Banheira revestida com porcelanato efeito mármore azul' },
	{ src: withBase('/assets/images/galeria/galeria-3.jpg'), alt: 'Detalhe de porcelanato efeito mármore branco e dourado' },
	{ src: withBase('/assets/images/galeria/galeria-4.jpg'), alt: 'Mostruário com diversos modelos de porcelanato' },
	{ src: withBase('/assets/images/galeria/galeria-5.jpg'), alt: 'Instalação de porcelanato efeito mármore branco e dourado' },
	{ src: withBase('/assets/images/galeria/galeria-6.jpg'), alt: 'Corredor com porcelanato efeito mármore branco polido' },
	{ src: withBase('/assets/images/galeria/galeria-7.jpg'), alt: 'Piso de granilite em banheiro' },
	{ src: withBase('/assets/images/galeria/galeria-8.jpg'), alt: 'Piso epóxi granilite branco com flocos' },
	{ src: withBase('/assets/images/galeria/galeria-9.jpg'), alt: 'Piso externo em blocos de concreto' },
];

const diferenciais = [
	{ icon: 'mdi:truck-delivery-outline', title: 'Entrega rápida', desc: 'Entregamos em toda a região com agilidade.' },
	{ icon: 'mdi:cash-multiple', title: 'Melhor preço', desc: 'Preço de fábrica direto para o consumidor final.' },
	{ icon: 'mdi:account-hard-hat-outline', title: 'Instalação parceira', desc: 'Indicamos instaladores de confiança para seu projeto.' },
	{ icon: 'mdi:shield-check-outline', title: 'Garantia de fábrica', desc: 'Todos os produtos com garantia do fabricante.' },
];
---

<Layout>
	<HomeHeroSection />

	<Container>
		<section class="categorias__section">
			<h2>Nossos produtos</h2>
			<p>Encontre o piso ideal para cada ambiente da sua casa ou do seu projeto.</p>
			<div class="categorias__grid">
				{categorias.map((c) => (
					<a class="categoria__card" href={c.href}>
						<img src={c.img} alt={c.title} loading="lazy" />
						<div class="categoria__content">
							<h3>{c.title}</h3>
							<p>{c.desc}</p>
						</div>
					</a>
				))}
			</div>
		</section>
	</Container>

	<StickyTextImageSection>
		<Fragment slot="text-container">
			<h2>Por que comprar na {settings.name}?</h2>
			<p>
				Trabalhamos direto com as principais fábricas do setor para trazer
				o melhor preço, com atendimento próximo e sem enrolação. Você manda uma
				mensagem, conta o que precisa, e a gente monta o orçamento na hora.
			</p>
			<ul class="diferenciais__list">
				{diferenciais.map((d) => (
					<li>
						<Icon name={d.icon} width={28} height={28} />
						<div>
							<strong>{d.title}</strong>
							<p>{d.desc}</p>
						</div>
					</li>
				))}
			</ul>
			<Button href={whatsappHref} newTab>Peça seu orçamento agora</Button>
		</Fragment>
		<Fragment slot="image-container">
			<img src={withBase("/assets/images/loja-fachada.jpg")} alt="Fachada da loja" />
		</Fragment>
	</StickyTextImageSection>

	<section class="photo-strip" aria-label="Fotos de produtos e ambientes">
		<div class="photo-strip__track">
			{[...galeriaFotos, ...galeriaFotos].map((foto) => (
				<div class="photo-strip__item">
					<img src={foto.src} alt={foto.alt} loading="lazy" />
				</div>
			))}
		</div>
	</section>

	<CtaCardSection>
		<h2>Vamos começar seu projeto?</h2>
		<p>Envie uma foto do ambiente e receba um orçamento personalizado em minutos.</p>
		<Button href={whatsappHref} newTab customIcon>
			Chamar no WhatsApp
			<Fragment slot="icon">
				<Icon name="mdi:whatsapp" />
			</Fragment>
		</Button>
	</CtaCardSection>
</Layout>

<style>
	.categorias__section {
		margin: var(--section-margin) auto;
	}
	.categorias__section > p {
		max-width: 40rem;
	}
	.categorias__grid {
		margin-top: 2rem;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--theme-grid-gap);
	}
	.categoria__card {
		display: block;
		text-decoration: none;
		color: inherit;
		background-color: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
		overflow: hidden;
		transition: transform var(--theme-transition);
	}
	.categoria__card:hover {
		transform: translateY(-4px);
	}
	.categoria__card img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		display: block;
	}
	.categoria__content {
		padding: 1rem;
	}
	.categoria__content h3 {
		margin: 0 0 0.25rem 0;
	}
	.categoria__content p {
		margin: 0;
		font-size: var(--font-size-sm);
		opacity: 0.8;
	}
	.diferenciais__list {
		margin: 1.5rem 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.diferenciais__list li {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
	}
	.diferenciais__list li :global(svg) {
		flex-shrink: 0;
		color: var(--theme-primary);
	}
	.diferenciais__list p {
		margin: 0.15rem 0 0 0;
		font-size: var(--font-size-sm);
		opacity: 0.8;
	}
	@media (max-width: 1024px) {
		.categorias__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 600px) {
		.categorias__grid {
			grid-template-columns: 1fr;
		}
	}
	.photo-strip {
		margin: calc(var(--section-margin) * 1.5) 0;
		overflow: hidden;
		width: 100%;
	}
	.photo-strip__track {
		display: flex;
		width: max-content;
		animation: photo-strip-scroll 32s linear infinite;
	}
	.photo-strip:hover .photo-strip__track {
		animation-play-state: paused;
	}
	.photo-strip__item {
		flex-shrink: 0;
		width: clamp(180px, 18vw, 260px);
		aspect-ratio: 3 / 4;
		margin-right: 1rem;
		border-radius: var(--theme-shape-radius);
		overflow: hidden;
	}
	.photo-strip__item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	@keyframes photo-strip-scroll {
		from {
			transform: translateX(0);
		}
		to {
			/* Anda exatamente metade da faixa (o outro metade é a cópia
			   duplicada), criando um loop contínuo e imperceptível. */
			transform: translateX(-50%);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.photo-strip__track {
			animation: none;
		}
	}
</style>
