---
import { Icon } from 'astro-icon/components'
import { withBase } from '../../utils/url.js';
const { navData, rightMenu } = Astro.props;
---

<script type="module">
  const bodyElement = document.querySelector('body');
  const menuButton = document.querySelector('#menuButton')
  const navHeader = document.querySelector('#odysseyNavHeader');
  const menuButtonIconHam = document.querySelector('#menuButtonIconHam');
  const menuButtonIconClose = document.querySelector('#menuButtonIconClose');
  let scrollPosition = 0;

  menuButton.addEventListener('click', toggleMenu)

  function toggleMenu() {
    menuButtonIconHam.toggleAttribute('hidden');
    menuButtonIconClose.toggleAttribute('hidden');
    
    if (navHeader.hasAttribute('mobile-menu-open', true)) {
      menuButton.title = "Open Main Menu"
      // unlock scroll position
      bodyElement.style.removeProperty('overflow');
      bodyElement.style.removeProperty('position');
      bodyElement.style.removeProperty('top');
      bodyElement.style.removeProperty('width');
      window.scrollTo(0, scrollPosition);
    } else {
      menuButton.title = "Close Main Menu"
      // lock scroll position
      scrollPosition = window.pageYOffset;
      bodyElement.style.overflow = 'hidden';
      bodyElement.style.position = 'fixed';
      bodyElement.style.top = `-${scrollPosition}px`;
      bodyElement.style.width = '100%';
    }
    
    navHeader.toggleAttribute('mobile-menu-open');
  }
</script>  

<header id="odysseyNavHeader" class={`${rightMenu ? "header--right" : ``.trim()}`}>
  <div class="header-logo-menu__container">
  <button id="menuButton" title="Open Main Menu">
    <span id="menuButtonIconHam">
      <Icon name="ic:baseline-menu" width="24px" height="24px" />
    </span>
    <span id="menuButtonIconClose" hidden>
      <Icon name="ic:baseline-close" width="24px" height="24px" />
    </span>
  </button>
  <a class="header-logo__link" href={withBase('/')}>
    <slot name="logo">
    </slot>
  </a>
  </div>
  <div class="header-nav__container">
    <slot name="nav">
      {navData && <nav id="main-nav" data-nav="categorias">
        <ul>
          {navData.map(navItem => (
            (<li>
              <a
                href={navItem.slug}
                id={`nav-link-${navItem.category ?? navItem.slug}`}
                data-category={navItem.category}
                data-nav-item
              >{navItem.title}</a>
            </li>)
          ))}
        </ul>
      </nav>}
    </slot>
    <div class="header-mobile-cta">
      <slot name="mobile-cta"></slot>
    </div>
  </div>
  <div class="header-action-item__container">
    <slot name="action-item">
    </slot>
  </div>
</header>

<style>
  header {
    width: 100%;
    padding: 0.38rem 0.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #141414;
    color: #f5f2ee;
  }
  header.header--right {
    display: grid;
    grid-template-columns: 1fr auto auto;
  }
  .header-logo__link {
    width: fit-content;
    color: inherit;
    text-decoration: none;
  }
  .header-logo-menu__container {
    display: flex;
    align-items: center;
    z-index: 100;
  }
  .header-action-item__container {
    z-index: 100;
  }
  #menuButton {
    outline: none;
    border: none;
    background-color: transparent;
    margin-right: 0.5rem;
    display: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  #menuButton > span {
    color: #f5f2ee;
    vertical-align: middle;
  }
  nav {
  display: flex;
  }
  nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
  }
  nav ul li a {
    text-decoration: none;
    margin-right: 1rem;
    color: inherit;
    opacity: 0.72;
    transition: opacity linear 150ms;
  }
  nav ul li a:hover {
    opacity: 1;
  }
  .header-mobile-cta {
    display: none;
  }
  @media(max-width: 600px) {
    #menuButton {
      display: block;  
      z-index: 100;
    }
    .header-nav__container {
      width: 100%;
      height: 100%;
      background-color: #141414;
      color: #f5f2ee;
      display: none;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      padding-top: 6rem;
      position: fixed;
      inset: 0;
      z-index: 99;
      overflow-y: auto;
    }
    header[mobile-menu-open] .header-nav__container {
      display: flex;
    }
    header[mobile-menu-open] nav {
      width: 100%;
    }
    header[mobile-menu-open] nav ul {
      align-items: stretch;
      flex-direction: column;
      width: 100%;
      padding: 0 1.5rem;
    }
    header[mobile-menu-open] nav ul li {
      font-size: var(--font-size-lg);
      margin-bottom: 0;
      border-bottom: 1px solid rgba(245, 242, 238, 0.12);
    }
    header[mobile-menu-open] nav ul li a {
      display: block;
      width: 100%;
      padding: 1.1rem 0.25rem;
      margin-right: 0;
      opacity: 1;
      font-weight: 500;
      color: #f5f2ee;
      transition: color 150ms linear;
    }
    header[mobile-menu-open] nav ul li a:hover,
    header[mobile-menu-open] nav ul li a:active {
      color: #d9773f;
    }
    header[mobile-menu-open] .header-mobile-cta {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      width: 100%;
      padding: 2rem 1.5rem 0 1.5rem;
    }
  }
</style>