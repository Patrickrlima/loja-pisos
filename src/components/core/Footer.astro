---
import { Icon } from 'astro-icon/components';
import Container  from '../core/Container.astro';
import Plug from './Plug.astro';
import { withBase } from '../../utils/url.js';
import settings from '../../config/settings.js';

const { footerSocials, footerLists, copyrightName, background, color, showPlug: showPlug = true } =
  Astro.props;

const whatsappHref = `https://wa.me/${settings.whatsappNumber}?text=${encodeURIComponent(settings.whatsappMessage)}`;

// Ícones reais das marcas (arquivos de imagem), no lugar de ícones de fonte.
const socialIconImages = {
	whatsapp: withBase('/assets/images/icon-whatsapp.png'),
	instagram: withBase('/assets/images/icon-instagram.png'),
	facebook: withBase('/assets/images/icon-facebook.png'),
};
---

<footer
  style={background && `--footer-bg:${background}; --footer-color:${color}`}
>
  <Container>
    <div class="footer-grid__container">
      <div class="footer-brand__container">
        <div>
          <slot name="logo" />
        </div>
        <p class="footer-brand__tagline">Pisos e revestimentos direto de fábrica.</p>
        <ul class="footer-socials__list">
          {
            footerSocials.map((social) => (
              <li class="footer-socials__item">
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="footer-socials__link"
                  title={`Abrir perfil de ${social.name}`}
                >
                  <img
                    src={socialIconImages[social.icon.split(':')[1]]}
                    alt={social.name}
                    class="footer-socials__icon"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      {
        footerLists.map((list) => (
          <div>
            <p class="footer-list__title"><strong>{list.title}</strong></p>
            <ul class="footer-link__list">
              {list.items.map((item) => (
                <li>
                  <a href={item.slug}>{item.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="footer-cta__container">
        <p class="footer-list__title"><strong>Fale com a gente</strong></p>
        <a
          id="btn-orcamento-footer"
          class="footer-cta__btn footer-cta__btn--orange"
          href={withBase('/contato')}
        >
          Peça um orçamento
        </a>
        <a
          id="btn-whatsapp-footer"
          class="footer-cta__btn footer-cta__btn--whatsapp"
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="mdi:whatsapp" width={18} height={18} />
          Falar no WhatsApp
        </a>
      </div>
    </div>
    <div class="footer-copyright__container">
      {showPlug && <Plug/>}
      <p>Copyright &copy; {new Date().getFullYear()} {copyrightName}</p>
    </div>

  </Container>
</footer>

<style>
  footer {
    --footer-bg: var(--theme-primary);
    --footer-color: var(--theme-on-primary);
    min-height: 40vh;
    background-color: var(--footer-bg);
    color: var(--footer-color);
    border-top-left-radius: var(--theme-shape-radius);
    border-top-right-radius: var(--theme-shape-radius);
  }
  .footer-grid__container {
    padding: 8vh 0 1rem 0;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
    gap: 1rem;
  }
  .footer-brand__tagline {
    margin: 0.75rem 0 0 0;
    font-size: var(--font-size-sm);
    opacity: 0.75;
    max-width: 22rem;
  }
  .footer-socials__list {
    margin: 1.25rem 0;
    padding: 0;
    display: flex;
    gap: 0.6rem;
    list-style: none;
  }
  .footer-socials__item {
    margin: 0;
  }
  .footer-socials__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    transition: transform var(--theme-transition);
  }
  .footer-socials__link:hover {
    transform: translateY(-2px);
  }
  .footer-socials__icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .footer-list__title {
    margin-bottom: 0.75rem;
  }
  .footer-link__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-link__list li {
    margin-bottom: 0.5rem;
  }
  .footer-link__list li a {
    text-decoration: none;
  }
  .footer-link__list li a:hover {
    opacity: 0.84;
  }
  .footer-cta__container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .footer-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    padding: 0.6rem 1.1rem;
    border-radius: var(--theme-button-border-radius);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--font-size-sm);
    color: #fff;
    margin-bottom: 0.75rem;
    transition: filter var(--theme-transition);
  }
  .footer-cta__btn:hover {
    filter: brightness(0.9);
  }
  .footer-cta__btn--orange {
    background-color: #d9773f;
  }
  .footer-cta__btn--whatsapp {
    background-color: #25D366;
  }
  .footer-copyright__container {
    display: flex;
    flex-direction: column;
    margin-top: 1rem;
  }
  .footer-copyright__container p {
    font-size: var(--font-size-sm);
  }
  @media (max-width: 768px) {
    .footer-grid__container :first-child {
      grid-column: 1/-1;
    }
    .footer-grid__container {
      padding: 5vh 0;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }
  @media (max-width: 600px) {
    .footer-grid__container {
      padding: 5vh 0;
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .footer-copyright__container {
      flex-direction: column;
    }
  }
</style>
