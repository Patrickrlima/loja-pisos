---
import { Icon } from 'astro-icon/components';
import { Button } from '@components/odyssey-theme';
import settings from '../../../config/settings.js';

const whatsappHref = `https://wa.me/${settings.whatsappNumber}?text=${encodeURIComponent(settings.whatsappMessage)}`;
---

<section class="hero" id="hero-home" data-section="hero">
	<img
		class="hero__bg"
		src="/assets/images/hero-casa-piscina.jpg"
		alt="Ambiente de alto padrão com piso de porcelanato"
		fetchpriority="high"
	/>
	<div class="hero__overlay"></div>

	<div class="hero__content">
		<img class="hero__logo" src={settings.logo} alt={settings.name} />
		<div class="hero__btns" data-hero-actions>
			<Button href={whatsappHref} newTab customIcon id="hero-cta-whatsapp" data-action="open-whatsapp"
				>Falar no WhatsApp
				<Fragment slot="icon">
					<Icon name="mdi:whatsapp" />
				</Fragment>
			</Button>
			<Button href="/produtos" outlined onPrimary id="hero-cta-produtos" data-route="produtos">Ver produtos</Button>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		width: 100%;
		min-height: clamp(70vh, 90vw, 92vh);
		display: flex;
		align-items: center;
		overflow: hidden;
	}
	.hero__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 0;
	}
	.hero__overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(
			90deg,
			rgba(20, 14, 10, 0.72) 0%,
			rgba(20, 14, 10, 0.45) 45%,
			rgba(20, 14, 10, 0.15) 100%
		);
	}
	.hero__content {
		position: relative;
		z-index: 2;
		max-width: 34rem;
		margin: 0 auto;
		padding: 2rem 1.5rem;
		color: #fff;
	}
	.hero__logo {
		display: block;
		height: clamp(7rem, 16vw, 11rem);
		width: auto;
		margin-bottom: 2rem;
		filter: brightness(0) invert(1);
	}
	.hero__btns {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.hero__btns :global(#hero-cta-produtos.btn--outlined) {
		color: #fff;
		border-color: #fff;
	}
	.hero__btns :global(#hero-cta-produtos.btn--outlined:hover) {
		background-color: #fff;
		color: var(--theme-primary);
	}
	@media (max-width: 600px) {
		.hero__overlay {
			background: linear-gradient(
				180deg,
				rgba(20, 14, 10, 0.35) 0%,
				rgba(20, 14, 10, 0.85) 65%
			);
		}
		.hero__content {
			padding: 1.5rem 1rem;
			max-width: 100%;
		}
	}
</style>
