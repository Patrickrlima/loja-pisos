---
import { Icon } from 'astro-icon/components';
import { Button } from '@components/odyssey-theme';
import settings from '../../../config/settings.js';
import { withBase } from '../../../utils/url.js';

const whatsappHref = `https://wa.me/${settings.whatsappNumber}?text=${encodeURIComponent(settings.whatsappMessage)}`;
---

<section class="hero" id="hero-home" data-section="hero">
	<video
		class="hero__bg"
		src={withBase('/assets/images/hero-video.mp4')}
		poster={withBase('/assets/images/hero-video-poster.jpg')}
		autoplay
		muted
		loop
		playsinline
		preload="auto"
	></video>
	<div class="hero__overlay"></div>

	<div class="hero__content">
		<img class="hero__logo" src={withBase('/assets/images/logo-classe-a-pisos-hero.png')} alt={settings.name} />
		<div class="hero__btns" data-hero-actions>
			<Button href={whatsappHref} newTab customIcon id="hero-cta-whatsapp" data-action="open-whatsapp"
				>Falar no WhatsApp
				<Fragment slot="icon">
					<Icon name="mdi:whatsapp" />
				</Fragment>
			</Button>
			<Button href={withBase('/produtos')} outlined onPrimary id="hero-cta-produtos" data-route="produtos">Ver produtos</Button>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		width: 100%;
		min-height: clamp(70vh, 90vw, 92vh);
		display: flex;
		align-items: center;
		overflow: hidden;
	}
	.hero__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 0;
	}
	.hero__overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(
			180deg,
			rgba(15, 12, 10, 0.35) 0%,
			rgba(15, 12, 10, 0.42) 55%,
			rgba(15, 12, 10, 0.65) 100%
		);
	}
	.hero__content {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: 34rem;
		margin: 0 auto;
		padding: 2rem 1.5rem;
		color: #fff;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}
	.hero__logo {
		display: block;
		width: min(494px, 80vw);
		height: auto;
		margin: 0 auto 2rem auto;
		filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.55));
	}
	.hero__btns {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.hero__btns :global(#hero-cta-produtos.btn--outlined) {
		color: #fff;
		border-color: #fff;
	}
	.hero__btns :global(#hero-cta-produtos.btn--outlined:hover) {
		background-color: #fff;
		color: var(--theme-primary);
	}
	@media (max-width: 600px) {
		.hero__content {
			padding: 1.5rem 1rem;
			max-width: 100%;
		}
	}
</style>
