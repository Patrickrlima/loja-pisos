---
import settings from '../config/settings.js';
import { withBase } from '../utils/url.js';
---

<img
	src={withBase(settings.logo)}
	alt={settings.name}
	class="site-logo__img"
	id="site-logo"
	data-route="home"
/>

<style>
	.site-logo__img {
		height: clamp(1.75rem, 3vw, 2.25rem);
		width: auto;
		display: block;
	}
</style>
